{
  "name": "loupe-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "LOUPE_DEV=1 vite build --watch --mode development",
    "dev:web": "vite --port 5174",
    "dev:mobile": "vite --config mobile/vite.config.ts",
    "build": "vite build",
    "build:mobile": "vite build --config mobile/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^14.2.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
