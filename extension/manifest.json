{
  "manifest_version": 3,
  "name": "Loupe",
  "version": "0.1.0",
  "description": "Loupe — the intelligence layer behind every purchase. A Perpay concept.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["sidePanel", "tabs", "activeTab", "storage"],
  "host_permissions": ["http://localhost:5175/*"],
  "action": {
    "default_title": "Open Loupe",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
